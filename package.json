{
  "name": "local-dev-studio",
  "productName": "Local Dev Studio",
  "version": "2.10.0",
  "description": "Local Developer Studio: capture any website into editable files, host and manage client sites locally, turn on-page feedback into AI-ready specs, and present any site on the big screen.",
  "homepage": "https://localdevstudio.com",
  "main": "main.js",
  "author": {
    "name": "NightShyft Studios"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "test": "eslint . && node --test test/*.test.js && node scripts/test.js",
    "smoke": "node scripts/smoke.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "release": "npm test && npm run dist",
    "e2e": "node scripts/e2e.js"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "single-file-cli": "^2.0.83"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5"
  },
  "build": {
    "appId": "com.nightshyft.siteslurp",
    "productName": "Local Dev Studio",
    "copyright": "Copyright © 2026 NightShyft Studios",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "mcp/**/*",
      "renderer/**/*",
      "vendor/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/single-file-cli/**",
      "node_modules/simple-cdp/**",
      "node_modules/ws/**",
      "mcp/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "LocalDevStudio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Local Dev Studio",
      "artifactName": "LocalDevStudio-Setup-${version}.${ext}",
      "uninstallDisplayName": "Local Dev Studio ${version}"
    },
    "portable": {
      "artifactName": "LocalDevStudio-${version}-portable.${ext}",
      "unpackDirName": "LocalDevStudio"
    },
    "publish": {
      "provider": "github",
      "owner": "TheMrGU",
      "repo": "local-dev-studio"
    }
  }
}
